# views/edt_import_view.py

from PyQt5.QtWidgets import (
    QWidget, QVBoxLayout, QLabel, QPushButton,
    QFileDialog, QLineEdit
)
from PyQt5.QtCore import Qt


class EDTImportView(QWidget):

    def __init__(self, controller):
        super().__init__()
        self.controller = controller

        layout = QVBoxLayout()

        titre = QLabel("📅 Importation Emploi du Temps")
        titre.setAlignment(Qt.AlignCenter)
        titre.setStyleSheet("font-size: 18px; font-weight: bold;")

        # --------------------------
        # Import fichier .ics
        # --------------------------
        btn_file = QPushButton("Importer un fichier .ics")
        btn_file.clicked.connect(self._import_file)

        # --------------------------
        # Import URL
        # --------------------------
        self.url_field = QLineEdit()
        self.url_field.setPlaceholderText("Coller ici l'URL de l'EDT")

        btn_url = QPushButton("Importer via URL")
        btn_url.clicked.connect(self._import_url)

        layout.addWidget(titre)
        layout.addWidget(btn_file)
        layout.addWidget(self.url_field)
        layout.addWidget(btn_url)
        layout.addStretch()

        self.setLayout(layout)

    def _import_file(self):
        file_path, _ = QFileDialog.getOpenFileName(
            self, "Choisir un fichier EDT", "", "Fichiers ICS (*.ics)"
        )
        if file_path:
            self.controller.import_edt_file(file_path)

    def _import_url(self):
        url = self.url_field.text().strip()
        if not url:
            self.controller.main.show_error("Veuillez entrer une URL.")
            return

        self.controller.import_edt_url(url)
