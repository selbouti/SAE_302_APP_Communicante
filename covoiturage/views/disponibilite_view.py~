from PyQt5.QtWidgets import QWidget, QVBoxLayout, QLabel, QListWidget
from PyQt5.QtCore import Qt


class DisponibiliteView(QWidget):
    """
    Affiche les disponibilités de l'utilisateur.
    """

    def __init__(self, controller):
        super().__init__()
        self.controller = controller

        layout = QVBoxLayout()

        titre = QLabel("🕒 Mes disponibilités")
        titre.setAlignment(Qt.AlignCenter)
        titre.setStyleSheet("font-size:18px;font-weight:bold;")

        self.list = QListWidget()

        layout.addWidget(titre)
        layout.addWidget(self.list)

        self.setLayout(layout)

    def showEvent(self, event):
        self.list.clear()

        user = self.controller.current_user
        if not user:
            return

        dispos = self.controller.dispo_model.get_user_dispos(user["id_user"])

        for d in dispos:
            self.list.addItem(
                f"{d['date_dispo']} : {d['heure_debut']} → {d['heure_fin']}"
            )

        super().showEvent(event)
